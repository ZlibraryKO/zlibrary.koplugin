msgstr "Đã lưu thông tin đăng nhập, nhưng hiện chưa thể kiểm tra."

msgid "Please set both username and password first."
msgstr "Vui lòng thiết lập cả tên đăng nhập và mật khẩu trước."

msgid "Sign-in"
msgstr "Đăng nhập"

#, lua-format
msgid "Searching for \"%s\"..."
msgstr "Đang tìm kiếm \"%s\"..."

#, lua-format
msgid "No results found for \"%s\"."
msgstr "Không tìm thấy kết quả cho \"%s\"."

#, lua-format
msgid "Loading more results (Page %s)..."
msgstr "Đang tải thêm kết quả (Trang %s)..."

msgid "Failed to load more results"
msgstr "Không thể tải thêm kết quả"

msgid "No more results found."
msgstr "Không có thêm kết quả."

msgid "Book ID is required."
msgstr "Yêu cầu phải có ID sách."

msgid "Loading comments..."
msgstr "Đang tải bình luận..."

msgid "Failed to load comments"
msgstr "Không thể tải bình luận"

msgid "Comments"
msgstr "Bình luận"

msgid "No comments to display"
msgstr "Không có bình luận nào để hiển thị"

msgid "Could not find the server address"
msgstr "Không tìm thấy địa chỉ máy chủ"

msgid "This Z-library server is refusing automated access"
msgstr "Máy chủ Z-library này từ chối truy cập tự động"

msgid "Credentials rejected or invalid response"
msgstr "Thông tin xác thực bị từ chối hoặc phản hồi không hợp lệ"

msgid "Request timed out - please check your connection and try again"
msgstr "Hết thời gian yêu cầu - vui lòng kiểm tra kết nối và thử lại"

msgid "Network request failed"
msgstr "Yêu cầu mạng thất bại"

msgid "The Z-library address may be wrong or no longer exist."
msgstr "Địa chỉ Z-library có thể bị sai hoặc không còn tồn tại."

msgid "Network connection error - please check your internet connection and try again"
msgstr "Lỗi kết nối mạng - vui lòng kiểm tra kết nối internet và thử lại"

msgid "Too many redirects"
msgstr "Quá nhiều lần chuyển hướng"

msgid "Try a different Z-library server."
msgstr "Hãy thử một máy chủ Z-library khác."

msgid "HTTP Error"
msgstr "Lỗi HTTP"

msgid "Unknown Status"
msgstr "Trạng thái không xác định"

msgid "The Z-library server address (URL) is not set. Please configure it in the Z-library plugin settings."
msgstr "Chưa thiết lập địa chỉ máy chủ (URL) Z-library. Vui lòng cấu hình trong cài đặt plugin Z-library."

msgid "Login failed: Empty response from server"
msgstr "Đăng nhập thất bại: Phản hồi trống từ máy chủ"

msgid "Login failed: Invalid response format"
msgstr "Đăng nhập thất bại: Định dạng phản hồi không hợp lệ"

msgid "Login failed"
msgstr "Đăng nhập thất bại"

msgid "No response received from server - please try again"
msgstr "Không nhận được phản hồi từ máy chủ - vui lòng thử lại"

msgid "Invalid response format from server"
msgstr "Định dạng phản hồi từ máy chủ không hợp lệ"

msgid "Search API error"
msgstr "Lỗi API tìm kiếm"

msgid "Failed to open target file"
msgstr "Không thể mở tệp đích"

msgid "Unknown error"
msgstr "Lỗi không xác định"

msgid "Download limit reached or file is an HTML page"
msgstr "Đã đạt giới hạn tải về hoặc tệp là trang HTML"

msgid "Failed to save downloaded file"
msgstr "Lưu tệp tải về thất bại"

msgid "Download HTTP Error"
msgstr "Lỗi HTTP khi tải về"

msgid "Z-library server URL not configured."
msgstr "Chưa cấu hình URL máy chủ Z-library."

msgid "Failed to fetch recommended books (no response body)."
msgstr "Lấy sách đề xuất thất bại (không có nội dung phản hồi)."

msgid "Failed to parse recommended books response."
msgstr "Không thể phân tích phản hồi sách đề xuất."

msgid "API returned an error for recommended books."
msgstr "API trả về lỗi đối với sách đề xuất."

msgid "Failed to fetch most popular books (no response body)."
msgstr "Lấy sách phổ biến nhất thất bại (không có nội dung phản hồi)."

msgid "Failed to parse most popular books response."
msgstr "Không thể phân tích phản hồi sách phổ biến nhất."

msgid "API returned an error for most popular books."
msgstr "API trả về lỗi đối với sách phổ biến nhất."

msgid "Z-library server URL not configured or book identifiers missing."
msgstr "Chưa cấu hình URL máy chủ Z-library hoặc thiếu mã định danh sách."

msgid "Failed to fetch book details (no response body)."
msgstr "Lấy chi tiết sách thất bại (không có nội dung phản hồi)."

msgid "Failed to parse book details response."
msgstr "Không thể phân tích phản hồi chi tiết sách."

msgid "API returned an error for book details."
msgstr "API trả về lỗi đối với chi tiết sách."

msgid "Failed to process book details."
msgstr "Xử lý chi tiết sách thất bại."

msgid "Failed to fetch download link (no response body)."
