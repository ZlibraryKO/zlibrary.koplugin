msgstr "Không có liên kết tải về trong phản hồi API."

msgid "Failed to fetch similar books (no response body)."
msgstr "Lấy sách tương tự thất bại (không có nội dung phản hồi)."

msgid "Failed to parse similar books response."
msgstr "Không thể phân tích phản hồi sách tương tự."

msgid "API returned an error for similar books."
msgstr "API trả về lỗi đối với sách tương tự."

msgid "Failed to fetch downloaded books (no response body)."
msgstr "Lấy danh sách sách đã tải thất bại (không có nội dung phản hồi)."

msgid "Failed to parse downloaded books response."
msgstr "Không thể phân tích phản hồi danh sách sách đã tải."

msgid "API returned an error for downloaded books."
msgstr "API trả về lỗi đối với danh sách sách đã tải."

msgid "Failed to fetch favorite books (no response body)."
msgstr "Lấy sách yêu thích thất bại (không có nội dung phản hồi)."

msgid "Failed to parse favorite books response."
msgstr "Không thể phân tích phản hồi sách yêu thích."

msgid "API returned an error for favorite books."
msgstr "API trả về lỗi đối với sách yêu thích."

msgid "Failed to remove the book from downloaded (no response body)."
msgstr "Xóa sách khỏi danh sách đã tải thất bại (không có nội dung phản hồi)."

msgid "Failed to parse the remove from downloaded response."
msgstr "Không thể phân tích phản hồi xóa sách khỏi danh sách đã tải."

msgid "API returned an error for remove from downloaded."
msgstr "API trả về lỗi khi xóa khỏi danh sách đã tải."

msgid "Failed to fetch unfavorite book (no response body)."
msgstr "Bỏ thích sách thất bại (không có nội dung phản hồi)."

msgid "Failed to parse unfavorite book response."
msgstr "Không thể phân tích phản hồi bỏ thích sách."

msgid "API returned an error for unfavorite book."
msgstr "API trả về lỗi khi bỏ thích sách."

msgid "Failed to fetch download quota status (no response body)."
msgstr "Lấy trạng thái hạn mức tải về thất bại (không có nội dung phản hồi)."

msgid "Failed to parse download quota status response."
msgstr "Không thể phân tích phản hồi trạng thái hạn mức tải về."

msgid "API returned an error for download quota status."
msgstr "API trả về lỗi đối với trạng thái hạn mức tải về."

msgid "Failed to fetch favorite-book IDs (no response body)."
msgstr "Lấy ID sách yêu thích thất bại (không có nội dung phản hồi)."

msgid "Failed to parse favorite-book IDs."
msgstr "Không thể phân tích ID sách yêu thích."

msgid "API returned an error for favorite-book IDs."
msgstr "API trả về lỗi đối với ID sách yêu thích."

msgid "Failed to fetch favorite book (no response body)."
msgstr "Lấy sách yêu thích thất bại (không có nội dung phản hồi)."

msgid "Failed to parse favorite book response."
msgstr "Không thể phân tích phản hồi sách yêu thích."

msgid "API returned an error for favorite book."
msgstr "API trả về lỗi đối với sách yêu thích."

msgid "Failed to fetch book comments (no response body)."
msgstr "Lấy bình luận sách thất bại (không có nội dung phản hồi)."

msgid "Failed to parse book comments response."
msgstr "Không thể phân tích phản hồi bình luận sách."

msgid "API returned an error for book comments."
msgstr "API trả về lỗi đối với bình luận sách."

msgid "Request cancelled."
msgstr "Yêu cầu đã bị hủy."

msgid "Profile"
msgstr "Hồ sơ"

msgid "No description available"
msgstr "Không có mô tả"

