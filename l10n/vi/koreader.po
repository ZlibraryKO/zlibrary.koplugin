msgid "Failed to parse download link response."
msgstr "Không thể phân tích phản hồi liên kết tải về."

msgid "API returned an error for download link."
msgstr "API trả về lỗi đối với liên kết tải về."

msgid "Download limit reached. Please try again later or check your account."
msgstr "Đã đạt giới hạn tải về. Vui lòng thử lại sau hoặc kiểm tra tài khoản của bạn."

