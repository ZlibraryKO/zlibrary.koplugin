msgid "The Z-library server address (URL) is not set. Please configure it in the Z-library plugin settings."
msgstr "Adresa serveru Z-library (URL) není nastavena. Nastavte ji prosím v nastavení pluginu Z-library."

msgid "No response received from server - please try again"
msgstr "Server neodeslal žádnou odpověď - zkuste to prosím znovu"

