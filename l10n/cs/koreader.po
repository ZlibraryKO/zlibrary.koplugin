msgid "Z-library"
msgstr "Z-library"

msgid "[[A plugin to search and download books from Z-library.]]"
msgstr "[[Plugin pro vyhledávání a stahování knih z Z-library.]]"

msgid "Z-library search"
msgstr "Vyhledávání na Z-library"

msgid "My books"
msgstr "Moje knihy"

