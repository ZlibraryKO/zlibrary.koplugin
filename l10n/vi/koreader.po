msgstr "Thiếu mã định danh sách. Không thể tải về."

#, lua-format
msgid "Cannot create downloads directory: %s"
msgstr "Không thể tạo thư mục tải về: %s"

#, lua-format
msgid "Couldn't create the folder for \"%s\". The book is in the download folder."
msgstr "Không thể tạo thư mục cho \"%s\". Sách được lưu tại thư mục tải về."

#, lua-format
msgid "Moved to \"%s\"."
msgstr "Đã di chuyển tới \"%s\"."

#, lua-format
msgid "Couldn't move the book into \"%s\". It's in the download folder."
msgstr "Không thể di chuyển sách vào \"%s\". Sách được lưu tại thư mục tải về."

msgid "Could not open reader UI."
msgstr "Không thể mở giao diện đọc sách."

msgid "Download failed: Unknown error"
msgstr "Tải về thất bại: Lỗi không xác định"

msgid "Book download"
msgstr "Tải sách về"

msgid "Retrying download… (tap to cancel)"
msgstr "Đang thử tải lại… (nhấn để hủy)"

msgid "Download cancelled."
msgstr "Đã hủy tải về."

msgid "Untitled"
msgstr "Không có tiêu đề"

msgid "Unknown Author"
msgstr "Tác giả không xác định"

msgid "Author"
msgstr "Tác giả"

msgid "Update failed: Could not determine where to install the plugin."
msgstr "Cập nhật thất bại: Không thể xác định vị trí cài đặt plugin."

msgid "Installing update..."
msgstr "Đang cài đặt bản cập nhật..."

msgid "Update installation failed."
msgstr "Cài đặt cập nhật thất bại."

msgid "Update installed successfully. Please restart KOReader for changes to take effect."
msgstr "Cập nhật thành công. Vui lòng khởi động lại KOReader để thay đổi có hiệu lực."

msgid "Update check failed: Could not determine plugin location."
msgstr "Kiểm tra cập nhật thất bại: Không thể xác định vị trí plugin."

#, lua-format
msgid "Unsupported plugin path for OTA update: %s. Only 'plugins/zlibrary.koplugin' is supported."
msgstr "Đường dẫn plugin không được hỗ trợ cập nhật OTA: %s. Chỉ hỗ trợ 'plugins/zlibrary.koplugin'."

msgid "Checking for updates..."
msgstr "Đang kiểm tra bản cập nhật..."

msgid "Failed to check for updates. Please check your internet connection."
msgstr "Kiểm tra bản cập nhật thất bại. Vui lòng kiểm tra kết nối internet."

msgid "Could not find update information (invalid data format)."
msgstr "Không tìm thấy thông tin cập nhật (định dạng dữ liệu không hợp lệ)."

msgid "Could not find update version information."
msgstr "Không tìm thấy thông tin phiên bản cập nhật."

msgid "Could not understand the update version format."
msgstr "Không nhận dạng được định dạng phiên bản cập nhật."

msgid "Could not find update files."
msgstr "Không tìm thấy các tệp cập nhật."

msgid "Could not find a download link for the update."
msgstr "Không tìm thấy liên kết tải về cho bản cập nhật."

