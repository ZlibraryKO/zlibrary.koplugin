msgstr "Kích thước tệp"

msgid "Default"
msgstr "Mặc định"

#, lua-format
msgid "%ds"
msgstr "%d giây"

msgid "infinite"
msgstr "vô hạn"

#, lua-format
msgid "Block: %ds, Total: %s"
msgstr "Khối: %d giây, Tổng cộng: %s"

msgid "Operation failed, please retry."
msgstr "Thao tác thất bại, vui lòng thử lại."

msgid "Fetching domains..."
msgstr "Đang lấy danh sách tên miền..."

msgid "Successfully set base URL to: "
msgstr "Đã đặt URL cơ sở thành: "

